{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "allowJs": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
